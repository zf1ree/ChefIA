# Copie para .env.local e preencha. Variáveis EXPO_PUBLIC_* são embutidas no app:
# coloque aqui SOMENTE valores públicos. Chaves privadas (IA, service role)
# ficam nos Secrets do Supabase, nunca no app.
EXPO_PUBLIC_APP_NAME=ChefIA
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
